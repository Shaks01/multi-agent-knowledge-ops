# Copy this file to .env and fill in your real key.
# .env is git-ignored — never commit real API keys.

# Google Gemini API key (used for Phase 1 onward).
# Get a free key (no credit card required) from Google AI Studio:
#   https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-key-here

# Optional: override the default model (see src/knowledge_ops/config.py).
# GEMINI_MODEL=gemini-2.5-flash
